# Copy this file to `.env` and paste your own keys in.
# `.env` is gitignored — it must never be committed.

# 1. Groq — primary provider. https://console.groq.com  (free, no card)
GROQ_API_KEY=

# 2. NaraRouter — OpenAI-compatible gateway. https://router.bynara.id  (free tier)
NARAROUTER_API_KEY=

# 3. Google Gemini — secondary. https://aistudio.google.com  (free, no card)
GEMINI_API_KEY=

# 4. OpenRouter — last resort. https://openrouter.ai  (free, no card)
OPENROUTER_API_KEY=

# --- Optional overrides (defaults below are built in) ---
# Free-tier catalogues churn. `python scripts/list_models.py` lists what
# each provider offers today; override here without touching any code.
# REPOMIND_GROQ_MODEL=openai/gpt-oss-120b
# REPOMIND_NARAROUTER_MODEL=laguna-s-2.1
# REPOMIND_GEMINI_MODEL=gemini-3.5-flash-lite
# REPOMIND_OPENROUTER_MODEL=google/gemma-4-31b-it:free
# REPOMIND_PROVIDER_ORDER=groq,nararouter,gemini,openrouter
